<!-- Estilos do PrimePC (identidade agressiva: vermelho e laranja, cantos retos, títulos condensados em maiúsculas, botões inclinados). Carregado depois do tema Fluent, para que os estilos derivados herdem a aparência nativa. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:PrimePC.Sensors;assembly=PrimePC.Sensors"
                    xmlns:dg="clr-namespace:PrimePC.Diagnostics;assembly=PrimePC.Diagnostics"
                    xmlns:vm="clr-namespace:PrimePC.App.ViewModels"
                    xmlns:c="clr-namespace:PrimePC.App.Controls"
                    xmlns:conv="clr-namespace:PrimePC.App.Converters">

    <FontFamily x:Key="Prime.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <!-- Fonte de títulos e números: Bahnschrift (estilo DIN/HUD, incluída no Windows 10/11), usada condensada -->
    <FontFamily x:Key="Prime.DisplayFont">Bahnschrift, Segoe UI</FontFamily>
    <!-- Cantos dos controles do tema Fluent mais retos (visual agressivo) -->
    <CornerRadius x:Key="ControlCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">3</CornerRadius>

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <conv:NullToVisibilityConverter x:Key="NotNullToVisibility" />
    <conv:NullToVisibilityConverter x:Key="NullToVisibility" Invert="True" />
    <conv:EmptyToVisibilityConverter x:Key="EmptyToVisibility" />
    <conv:EmptyToVisibilityConverter x:Key="NotEmptyToVisibility" Invert="True" />
    <conv:UpperCaseConverter x:Key="UpperCase" />

    <!-- Tipografia -->
    <Style x:Key="Prime.PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Prime.DisplayFont}" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontStretch" Value="Condensed" />
        <Setter Property="Foreground" Value="{DynamicResource Prime.Text}" />
    </Style>
    <Style x:Key="Prime.H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Prime.DisplayFont}" />
        <Setter Property="FontSize" Value="18.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontStretch" Value="SemiCondensed" />
        <Setter Property="Foreground" Value="{DynamicResource Prime.Text}" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Prime.H3" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Prime.DisplayFont}" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontStretch" Value="SemiCondensed" />
        <Setter Property="Foreground" Value="{DynamicResource Prime.Text}" />
        <Setter Property="Margin" Value="0,6,0,4" />
    </Style>
    <Style x:Key="Prime.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Prime.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Prime.Secondary" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource Prime.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Prime.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource Prime.TextSecondary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- Rótulo curto em maiúsculas, estilo painel de instrumentos -->
    <Style x:Key="Prime.HudLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Prime.DisplayFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontStretch" Value="SemiCondensed" />
        <Setter Property="Foreground" Value="{DynamicResource Prime.TextSecondary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Prime.Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Prime.IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Cartões e superfícies -->
    <Style x:Key="Prime.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Prime.CardBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Prime.CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="18,16" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
    <Style x:Key="Prime.Subtle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Prime.SubtleBg}" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <!-- Avisos (banners) -->
    <Style x:Key="Prime.Banner" TargetType="Border">
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Prime.AccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Prime.Accent}" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="Warning">
                <Setter Property="Background" Value="{DynamicResource Prime.WarnSoft}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Prime.Warn}" />
            </Trigger>
            <Trigger Property="Tag" Value="Critical">
                <Setter Property="Background" Value="{DynamicResource Prime.CritSoft}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Prime.Crit}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Selo de estado do sensor (normal / atenção / crítico / indisponível) -->
    <Style x:Key="Prime.StateBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="8,1,8,2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Prime.OkSoft}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Prime.Ok}" />
        <Setter Property="TextElement.FontSize" Value="11.5" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="{x:Static s:SensorState.Warning}">
                <Setter Property="Background" Value="{DynamicResource Prime.WarnSoft}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Prime.Warn}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static s:SensorState.Critical}">
                <Setter Property="Background" Value="{DynamicResource Prime.CritSoft}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Prime.Crit}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static s:SensorState.Unavailable}">
                <Setter Property="Background" Value="{DynamicResource Prime.MutedSoft}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Prime.Muted}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Texto colorido pelo estado -->
    <Style x:Key="Prime.StateValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Prime.Text}" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="{x:Static s:SensorState.Warning}">
                <Setter Property="Foreground" Value="{DynamicResource Prime.Warn}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static s:SensorState.Critical}">
                <Setter Property="Foreground" Value="{DynamicResource Prime.Crit}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static s:SensorState.Unavailable}">
                <Setter Property="Foreground" Value="{DynamicResource Prime.Muted}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Selo de confiança do diagnóstico (provável / possível / não indicado / inconclusivo) -->
    <Style x:Key="Prime.LikelihoodBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="9,2,9,3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Prime.OkSoft}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Prime.Ok}" />
        <Setter Property="TextElement.FontSize" Value="11.5" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="{x:Static dg:Likelihood.Probable}">
                <Setter Property="Background" Value="{DynamicResource Prime.CritSoft}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Prime.Crit}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static dg:Likelihood.Possible}">
                <Setter Property="Background" Value="{DynamicResource Prime.WarnSoft}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Prime.Warn}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static dg:Likelihood.Inconclusive}">
                <Setter Property="Background" Value="{DynamicResource Prime.MutedSoft}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Prime.Muted}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Navegação lateral: item selecionado com faixa em degradê e barra neon com brilho -->
    <Style x:Key="Prime.NavItem" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="10,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bg" CornerRadius="3" Background="Transparent" Padding="12,10" BorderThickness="1" BorderBrush="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Indicator" Width="4" Height="24" CornerRadius="0" Margin="-12,0,0,0"
                                    HorizontalAlignment="Left" Background="{DynamicResource Prime.AccentGradient}" Visibility="Hidden">
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource Prime.AccentColor}" BlurRadius="12" ShadowDepth="0" Opacity="0.9" />
                                </Border.Effect>
                            </Border>
                            <TextBlock Grid.Column="0" Text="{Binding Glyph}" Style="{StaticResource Prime.Icon}" Margin="2,0,12,0"
                                       Foreground="{DynamicResource Prime.TextSecondary}" x:Name="Glyph" />
                            <TextBlock Grid.Column="1" x:Name="Label" Text="{Binding Title, Converter={StaticResource UpperCase}}" FontFamily="{StaticResource Prime.DisplayFont}" FontSize="14.5" FontWeight="SemiBold" FontStretch="SemiCondensed"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Prime.TextSecondary}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Prime.NavHover}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Prime.Text}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Prime.NavSelected}" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Prime.Accent}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Prime.Text}" />
                            <Setter TargetName="Label" Property="FontWeight" Value="Bold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Prime.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Abas em pílula (Sensores, Drivers): item com Label, Glyph, Count, Worst e IsVisible -->
    <Style x:Key="Prime.TabPill" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bg" CornerRadius="2" Padding="16,8,14,8" BorderThickness="1" RenderTransformOrigin="0.5,0.5"
                            Background="{DynamicResource Prime.CardBg}" BorderBrush="{DynamicResource Prime.CardBorder}">
                        <!-- Aba inclinada (estilo "racing"); o conteúdo volta a ficar reto -->
                        <Border.RenderTransform>
                            <SkewTransform AngleX="-14" />
                        </Border.RenderTransform>
                        <StackPanel Orientation="Horizontal" RenderTransformOrigin="0.5,0.5">
                            <StackPanel.RenderTransform>
                                <SkewTransform AngleX="14" />
                            </StackPanel.RenderTransform>
                            <TextBlock x:Name="Glyph" Text="{Binding Glyph}" Style="{StaticResource Prime.Icon}" FontSize="15"
                                       Foreground="{DynamicResource Prime.Accent}" />
                            <TextBlock x:Name="Label" Text="{Binding Label, Converter={StaticResource UpperCase}}" FontFamily="{StaticResource Prime.DisplayFont}" FontSize="14.5"
                                       FontWeight="Bold" FontStretch="SemiCondensed" Margin="9,0,9,0" VerticalAlignment="Center" Foreground="{DynamicResource Prime.Text}" />
                            <Border x:Name="CountBg" CornerRadius="2" Padding="7,1,7,2" Background="{DynamicResource Prime.MutedSoft}" VerticalAlignment="Center">
                                <TextBlock x:Name="CountText" Text="{Binding Count}" FontFamily="{StaticResource Prime.DisplayFont}" FontSize="11.5"
                                           FontWeight="SemiBold" Foreground="{DynamicResource Prime.TextSecondary}" />
                            </Border>
                            <Ellipse x:Name="StateDot" Width="8" Height="8" Margin="7,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                                     ToolTip="Há sensores em atenção ou em estado crítico nesta aba" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Count}" Value="{x:Null}">
                            <Setter TargetName="CountBg" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Worst}" Value="Warning">
                            <Setter TargetName="StateDot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="StateDot" Property="Fill" Value="{DynamicResource Prime.Warn}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Worst}" Value="Critical">
                            <Setter TargetName="StateDot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="StateDot" Property="Fill" Value="{DynamicResource Prime.Crit}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Prime.Accent}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Prime.AccentGradient}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="Bg" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{DynamicResource Prime.AccentColor}" BlurRadius="16" ShadowDepth="0" Opacity="0.55" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Prime.OnAccent}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Prime.OnAccent}" />
                            <Setter TargetName="CountBg" Property="Background" Value="#33000000" />
                            <Setter TargetName="CountText" Property="Foreground" Value="{DynamicResource Prime.OnAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botões -->
    <Style x:Key="Prime.PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource Prime.AccentGradient}" />
        <Setter Property="Foreground" Value="{DynamicResource Prime.OnAccent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource Prime.DisplayFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontStretch" Value="SemiCondensed" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="Padding" Value="20,8" />
        <Setter Property="MinWidth" Value="110" />
        <!-- Botão inclinado (estilo "racing"), com o texto em maiúsculas e reto -->
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <SkewTransform AngleX="-12" />
            </Setter.Value>
        </Setter>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource UpperCase}}" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <SkewTransform AngleX="12" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{DynamicResource Prime.AccentColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.55" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
                <Setter Property="Effect" Value="{x:Null}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Prime.Button" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="MinWidth" Value="90" />
        <Setter Property="FontFamily" Value="{StaticResource Prime.DisplayFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontStretch" Value="SemiCondensed" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource UpperCase}}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Prime.Accent}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Prime.IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="6" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource Prime.IconFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Barras de progresso em degradê da marca -->
    <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
        <Setter Property="Foreground" Value="{DynamicResource Prime.AccentGradient}" />
    </Style>

    <!-- Bloco de métrica (rótulo em maiúsculas + valor grande colorido pelo estado; dica com o motivo) -->
    <DataTemplate DataType="{x:Type vm:MetricItem}">
        <StackPanel Margin="0,0,26,12" MinWidth="110" ToolTip="{Binding Tooltip}" ToolTipService.ShowOnDisabled="True">
            <TextBlock Text="{Binding Label, Converter={StaticResource UpperCase}}" Style="{StaticResource Prime.HudLabel}" />
            <TextBlock Text="{Binding Value}" Tag="{Binding State}" Style="{StaticResource Prime.StateValue}"
                       FontFamily="{StaticResource Prime.DisplayFont}" FontSize="25" FontWeight="Bold" FontStretch="SemiCondensed" Margin="0,2,0,0" />
        </StackPanel>
    </DataTemplate>

    <Style x:Key="Prime.DataGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Prime.CardBorder}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>
</ResourceDictionary>
