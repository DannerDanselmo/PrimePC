<!-- Paleta escura do PrimePC — identidade agressiva: preto neutro, vermelho e laranja, bordas com brilho vermelho. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Marca -->
    <Color x:Key="Prime.AccentColor">#FF2340</Color>
    <Color x:Key="Prime.Accent2Color">#FF7A18</Color>
    <SolidColorBrush x:Key="Prime.Accent" Color="#FF3A55" />
    <SolidColorBrush x:Key="Prime.Accent2" Color="#FF8A2E" />
    <SolidColorBrush x:Key="Prime.AccentSoft" Color="#2A0A10" />
    <SolidColorBrush x:Key="Prime.OnAccent" Color="#0B0507" />
    <LinearGradientBrush x:Key="Prime.AccentGradient" StartPoint="0,0" EndPoint="1,0.6">
        <GradientStop Color="#FF1E3C" Offset="0" />
        <GradientStop Color="#FF6A1A" Offset="1" />
    </LinearGradientBrush>

    <!-- Superfícies -->
    <SolidColorBrush x:Key="Prime.WindowBackground" Color="#08080A" />
    <RadialGradientBrush x:Key="Prime.Glow1" Center="0.95,0.0" GradientOrigin="0.95,0.0" RadiusX="0.6" RadiusY="0.7">
        <GradientStop Color="#3DFF2340" Offset="0" />
        <GradientStop Color="#00FF2340" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Prime.Glow2" Center="0.05,1.0" GradientOrigin="0.05,1.0" RadiusX="0.5" RadiusY="0.55">
        <GradientStop Color="#24FF6A1A" Offset="0" />
        <GradientStop Color="#00FF6A1A" Offset="1" />
    </RadialGradientBrush>
    <!-- Listras diagonais bem sutis no fundo (textura "industrial") -->
    <DrawingBrush x:Key="Prime.Stripes" TileMode="Tile" Viewport="0,0,14,14" ViewportUnits="Absolute" Viewbox="0,0,14,14" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Geometry="M-1,15 L15,-1">
                <GeometryDrawing.Pen>
                    <Pen Brush="#0CFFFFFF" Thickness="1.2" />
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <SolidColorBrush x:Key="Prime.Sidebar" Color="#F00A0A0D" />
    <SolidColorBrush x:Key="Prime.CardBg" Color="#E6111115" />
    <SolidColorBrush x:Key="Prime.CardBorder" Color="#2B1E22" />
    <!-- Borda dos cartões: brilho vermelho no canto superior esquerdo que some para o cinza -->
    <LinearGradientBrush x:Key="Prime.CardBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#CCFF2340" Offset="0" />
        <GradientStop Color="#40FF2340" Offset="0.10" />
        <GradientStop Color="#26262D" Offset="0.35" />
        <GradientStop Color="#1C1C22" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Prime.SubtleBg" Color="#18181D" />

    <!-- Texto -->
    <SolidColorBrush x:Key="Prime.Text" Color="#F5F5F7" />
    <SolidColorBrush x:Key="Prime.TextSecondary" Color="#A2A2AE" />

    <!-- Estados (crítico em rosa-avermelhado, para não se confundir com o vermelho da marca) -->
    <SolidColorBrush x:Key="Prime.Ok" Color="#2EE57D" />
    <SolidColorBrush x:Key="Prime.OkSoft" Color="#0A2A18" />
    <SolidColorBrush x:Key="Prime.Warn" Color="#FFC233" />
    <SolidColorBrush x:Key="Prime.WarnSoft" Color="#33280A" />
    <SolidColorBrush x:Key="Prime.Crit" Color="#FF3D8B" />
    <SolidColorBrush x:Key="Prime.CritSoft" Color="#3A0C1F" />
    <SolidColorBrush x:Key="Prime.Muted" Color="#70707C" />
    <SolidColorBrush x:Key="Prime.MutedSoft" Color="#1C1C22" />

    <!-- Gráficos -->
    <SolidColorBrush x:Key="Prime.ChartGrid" Color="#202027" />
    <SolidColorBrush x:Key="Prime.Chart1" Color="#FF2340" />
    <LinearGradientBrush x:Key="Prime.Chart1Fill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#55FF2340" Offset="0" />
        <GradientStop Color="#00FF2340" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Prime.Chart2" Color="#E8E8EE" />
    <LinearGradientBrush x:Key="Prime.Chart2Fill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#40E8E8EE" Offset="0" />
        <GradientStop Color="#00E8E8EE" Offset="1" />
    </LinearGradientBrush>

    <!-- Navegação -->
    <SolidColorBrush x:Key="Prime.NavHover" Color="#17171C" />
    <LinearGradientBrush x:Key="Prime.NavSelected" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#55FF2340" Offset="0" />
        <GradientStop Color="#00FF2340" Offset="1" />
    </LinearGradientBrush>

    <!-- Cores de destaque do tema Fluent (caixas de seleção, controles deslizantes, foco), alinhadas à marca -->
    <Color x:Key="SystemAccentColor">#FF2340</Color>
    <Color x:Key="SystemAccentColorLight1">#FF4F66</Color>
    <Color x:Key="SystemAccentColorLight2">#FF7A8C</Color>
    <Color x:Key="SystemAccentColorLight3">#FFA6B2</Color>
    <Color x:Key="SystemAccentColorDark1">#D9102C</Color>
    <Color x:Key="SystemAccentColorDark2">#A80C22</Color>
    <Color x:Key="SystemAccentColorDark3">#750818</Color>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF2340" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E6FF2340" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CCFF2340" />
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#A80C22" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF7A8C" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FFA6B2" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#FF4F66" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#0B0507" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#2A1418" />
    <!-- Caixas de seleção e botões de opção do Fluent (usam chaves próprias por controle) -->
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#FF2340" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#FF4F66" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#D9102C" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#FF2340" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#FF4F66" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#D9102C" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForeground" Color="#0B0507" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPressed" Color="#0B0507" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="#FF2340" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="#FF2340" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="#FF4F66" />
    <SolidColorBrush x:Key="RadioButtonCheckOuterEllipseCheckedFillPointerOver" Color="#FF4F66" />
    <SolidColorBrush x:Key="RadioButtonCheckOuterEllipseCheckedFillPressed" Color="#D9102C" />
    <SolidColorBrush x:Key="RadioButtonCheckOuterEllipseCheckedStrokePressed" Color="#D9102C" />
    <!-- Controle deslizante do Fluent: faixa preenchida e ponto central -->
    <SolidColorBrush x:Key="SliderThumbBackground" Color="#FF2340" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FF4F66" />
</ResourceDictionary>
