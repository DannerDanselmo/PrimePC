<UserControl x:Class="PrimePC.App.Views.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,4,32,28">

            <Border Style="{StaticResource Prime.Card}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Atualizar" Style="{StaticResource Prime.Button}" Command="{Binding RefreshDisksCommand}" />
                        <TextBlock Text="Discos detectados" Style="{StaticResource Prime.H2}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Prime.Secondary}" Margin="0,0,0,10"
                               Text="Saúde informada pelo Windows, contadores de confiabilidade (horas ligado, desgaste, erros) e sensores SMART/NVMe. Passe o mouse sobre um valor para ver a origem ou o motivo de indisponibilidade." />
                    <TextBlock Style="{StaticResource Prime.Secondary}" Margin="0,0,0,10" Foreground="{DynamicResource Prime.Warn}"
                               Visibility="{Binding IsAdministrator, Converter={StaticResource InverseBoolToVisibility}}"
                               Text="Sem privilégios de administrador: temperatura, SMART e contadores de confiabilidade não podem ser lidos. Use &quot;Reiniciar como administrador&quot; no aviso acima." />
                    <ItemsControl ItemsSource="{Binding Disks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Prime.Subtle}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Prime.Text}" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Prime.Caption}" />
                                        <TextBlock Text="{Binding Volumes}" Style="{StaticResource Prime.Secondary}" Margin="0,2,0,10" />
                                        <ItemsControl ItemsSource="{Binding Metrics}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Prime.Card}">
                <StackPanel>
                    <TextBlock Text="Teste de velocidade (não destrutivo)" Style="{StaticResource Prime.H2}" />
                    <TextBlock Style="{StaticResource Prime.Secondary}" Margin="0,0,0,12"
                               Text="Grava um arquivo temporário próprio, mede leitura/gravação sequencial (blocos de 1 MiB) e aleatória (4 KiB) sem o cache do Windows e apaga o arquivo ao final. Nenhum arquivo seu é lido ou alterado. Testes destrutivos não são oferecidos." />
                    <WrapPanel IsEnabled="{Binding IsIdle}">
                        <StackPanel Margin="0,0,16,10">
                            <TextBlock Text="Volume" Style="{StaticResource Prime.Caption}" Margin="0,0,0,3" />
                            <ComboBox Width="420" ItemsSource="{Binding VolumeOptions}" SelectedItem="{Binding SelectedVolume}" DisplayMemberPath="Label" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,10">
                            <TextBlock Text="Tamanho do arquivo (MB)" Style="{StaticResource Prime.Caption}" Margin="0,0,0,3" />
                            <ComboBox Width="120" ItemsSource="{Binding SizeOptionsMb}" SelectedItem="{Binding SizeMb}" />
                        </StackPanel>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Iniciar teste" Style="{StaticResource Prime.PrimaryButton}" Command="{Binding StartCommand}" Margin="0,0,10,0" />
                        <Button Content="Cancelar" Style="{StaticResource Prime.Button}" Command="{Binding CancelCommand}" />
                    </StackPanel>
                    <StackPanel Margin="0,12,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Phase}" Style="{StaticResource Prime.Body}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="5" />
                    </StackPanel>
                    <TextBlock Text="{Binding LastSummary}" Style="{StaticResource Prime.Body}" FontWeight="SemiBold" Margin="0,12,0,4"
                               Visibility="{Binding LastSummary, Converter={StaticResource NotNullToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding ResultNotes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='• {0}'}" Style="{StaticResource Prime.Secondary}" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Histórico" Style="{StaticResource Prime.H3}" Margin="0,12,0,4"
                               Visibility="{Binding Results.Count, Converter={StaticResource NotEmptyToVisibility}}" />
                    <DataGrid ItemsSource="{Binding Results}" Style="{StaticResource Prime.DataGrid}"
                              Visibility="{Binding Results.Count, Converter={StaticResource NotEmptyToVisibility}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Data" Binding="{Binding When}" Width="Auto" />
                            <DataGridTextColumn Header="Volume" Binding="{Binding Volume}" Width="1.5*" />
                            <DataGridTextColumn Header="Leitura seq." Binding="{Binding SeqRead}" Width="*" />
                            <DataGridTextColumn Header="Gravação seq." Binding="{Binding SeqWrite}" Width="*" />
                            <DataGridTextColumn Header="4K leitura (QD1)" Binding="{Binding RndRead}" Width="1.3*" />
                            <DataGridTextColumn Header="4K gravação (QD1)" Binding="{Binding RndWrite}" Width="1.3*" />
                            <DataGridTextColumn Header="4K leitura (4 threads)" Binding="{Binding RndReadQ4}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
