<UserControl x:Class="PrimePC.App.Views.BottleneckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PrimePC.App.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="BulletTemplate">
            <DockPanel Margin="0,2">
                <TextBlock Text="•" Foreground="{DynamicResource Prime.TextSecondary}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding}" Style="{StaticResource Prime.Body}" />
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,4,32,28">

            <!-- Gravação -->
            <Border Style="{StaticResource Prime.Card}">
                <StackPanel>
                    <TextBlock Text="Nova gravação" Style="{StaticResource Prime.H2}" />
                    <TextBlock Style="{StaticResource Prime.Secondary}" Margin="0,0,0,12"
                               Text="Inicie a gravação, abra o jogo ou programa e use-o normalmente por 2 a 5 minutos numa cena representativa; depois volte e pare. A gravação continua mesmo com o PrimePC em segundo plano. Os campos abaixo são opcionais e servem para comparar sessões." />
                    <WrapPanel IsEnabled="{Binding IsIdle}">
                        <StackPanel Margin="0,0,14,10">
                            <TextBlock Text="Jogo ou carga" Style="{StaticResource Prime.Caption}" Margin="0,0,0,3" />
                            <TextBox Width="220" Text="{Binding Workload, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,10">
                            <TextBlock Text="Resolução" Style="{StaticResource Prime.Caption}" Margin="0,0,0,3" />
                            <TextBox Width="130" Text="{Binding Resolution, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ex.: 2560×1440" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,10">
                            <TextBlock Text="Configurações gráficas" Style="{StaticResource Prime.Caption}" Margin="0,0,0,3" />
                            <TextBox Width="220" Text="{Binding SettingsNotes, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ex.: Ultra, DLSS Qualidade, sem limite de FPS" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,10">
                            <TextBlock Text="Placa de vídeo analisada" Style="{StaticResource Prime.Caption}" Margin="0,0,0,3" />
                            <ComboBox Width="280" ItemsSource="{Binding GpuOptions}" SelectedItem="{Binding SelectedGpu}" DisplayMemberPath="Name" />
                        </StackPanel>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="Iniciar gravação" Style="{StaticResource Prime.PrimaryButton}" Command="{Binding StartCommand}" Margin="0,0,10,0" />
                        <Button Content="Parar e analisar" Style="{StaticResource Prime.Button}" Command="{Binding StopCommand}" />
                    </StackPanel>

                    <Border Style="{StaticResource Prime.Subtle}" Margin="0,14,0,0"
                            Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Prime.Body}" FontWeight="SemiBold">
                                <Run Text="● Gravando · " Foreground="{DynamicResource Prime.Crit}" /><Run Text="{Binding ElapsedText, Mode=OneWay}" /><Run
                                    Text=" · " /><Run Text="{Binding SampleCount, Mode=OneWay}" /><Run Text=" amostras" />
                            </TextBlock>
                            <ProgressBar Value="{Binding MinimumProgress, Mode=OneWay}" Maximum="100" Height="4" Margin="0,8,0,4" />
                            <TextBlock Text="Mínimo de 30 segundos para uma análise; quanto mais longa e representativa, melhor." Style="{StaticResource Prime.Caption}" />
                            <WrapPanel Margin="0,10,0,0">
                                <StackPanel Margin="0,0,28,0">
                                    <TextBlock Text="FPS" Style="{StaticResource Prime.Caption}" />
                                    <TextBlock Text="{Binding LiveFps}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource Prime.Accent}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,28,0">
                                    <TextBlock Text="Uso da GPU" Style="{StaticResource Prime.Caption}" />
                                    <TextBlock Text="{Binding LiveGpu}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource Prime.Text}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,28,0">
                                    <TextBlock Text="Thread mais ocupada" Style="{StaticResource Prime.Caption}" />
                                    <TextBlock Text="{Binding LiveThread}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource Prime.Text}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,28,0">
                                    <TextBlock Text="CPU total" Style="{StaticResource Prime.Caption}" />
                                    <TextBlock Text="{Binding LiveCpu}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource Prime.Text}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,28,0">
                                    <TextBlock Text="VRAM" Style="{StaticResource Prime.Caption}" />
                                    <TextBlock Text="{Binding LiveVram}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource Prime.Text}" />
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Text="{Binding LiveFpsHint}" Style="{StaticResource Prime.Caption}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Resultado -->
            <Border Style="{StaticResource Prime.Card}" Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding ReportSessionName}" Style="{StaticResource Prime.Caption}" />
                    <DockPanel Margin="0,4,0,6">
                        <Border Style="{StaticResource Prime.LikelihoodBadge}" Tag="{Binding Report.HeadlineLikelihood}" Margin="0,0,10,0">
                            <TextBlock Text="Conclusão" />
                        </Border>
                        <TextBlock Text="{Binding Report.Headline}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Prime.Text}"
                                   TextWrapping="Wrap" />
                    </DockPanel>
                    <TextBlock Text="{Binding Report.Explanation}" Style="{StaticResource Prime.Body}" Margin="0,0,0,12" />

                    <TextBlock Style="{StaticResource Prime.Caption}" Margin="0,0,0,4">
                        <Run Text="━ Uso da GPU" Foreground="{DynamicResource Prime.Chart1}" /><Run Text="     " /><Run
                            Text="━ Thread mais ocupada da CPU" Foreground="{DynamicResource Prime.Chart2}" /><Run Text="   (%)" />
                    </TextBlock>
                    <c:LineChart Height="150" Series="{Binding GpuLoadSeries}" Series2="{Binding ThreadSeries}" Minimum="0" Maximum="100"
                                 Stroke="{DynamicResource Prime.Chart1}" Stroke2="{DynamicResource Prime.Chart2}"
                                 GridBrush="{DynamicResource Prime.ChartGrid}" TextBrush="{DynamicResource Prime.TextSecondary}" Margin="0,0,0,14" />

                    <!-- Fluidez: FPS medido a cada quadro -->
                    <Border Style="{StaticResource Prime.Subtle}" Margin="0,0,0,14" Visibility="{Binding HasFrames, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Border Style="{StaticResource Prime.StateBadge}" Tag="{Binding SmoothnessState}" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SmoothnessTitle}" />
                                </Border>
                                <TextBlock Text="Fluidez (FPS medido a cada quadro)" Style="{StaticResource Prime.H3}" Margin="0" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{Binding FramesSource}" Style="{StaticResource Prime.Caption}" Margin="0,0,0,8" />
                            <WrapPanel>
                                <WrapPanel.Resources>
                                    <Style x:Key="Big" TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="22" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="FontFamily" Value="{StaticResource Prime.DisplayFont}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Prime.Text}" />
                                    </Style>
                                </WrapPanel.Resources>
                                <StackPanel Margin="0,0,32,6">
                                    <TextBlock Text="FPS médio" Style="{StaticResource Prime.Caption}" />
                                    <TextBlock Text="{Binding AvgFpsText}" Style="{StaticResource Big}" Foreground="{DynamicResource Prime.Accent}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,32,6" ToolTip="FPS médio do 1% de quadros mais lentos">
                                    <TextBlock Text="1% low" Style="{StaticResource Prime.Caption}" />
                                    <TextBlock Text="{Binding Low1Text}" Style="{StaticResource Big}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,32,6" ToolTip="FPS médio do 0,1% de quadros mais lentos (exige pelo menos 1000 quadros)">
                                    <TextBlock Text="0,1% low" Style="{StaticResource Prime.Caption}" />
                                    <TextBlock Text="{Binding Low01Text}" Style="{StaticResource Big}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,32,6" ToolTip="Quadros muito mais lentos que o normal (mais de 2,5× o tempo típico)">
                                    <TextBlock Text="Travadas" Style="{StaticResource Prime.Caption}" />
                                    <TextBlock Text="{Binding StuttersText}" Style="{StaticResource Big}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,32,6">
                                    <TextBlock Text="Pior quadro" Style="{StaticResource Prime.Caption}" />
                                    <TextBlock Text="{Binding WorstFrameText}" Style="{StaticResource Big}" />
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Text="Tempo de cada quadro ao longo da gravação (picos = travadas; linha tracejada = 16,7 ms, 60 FPS)"
                                       Style="{StaticResource Prime.Caption}" Margin="0,6,0,4" />
                            <c:FrameTimeGraph Values="{Binding FrameGraph}" Height="90" />
                            <TextBlock Text="{Binding SmoothnessDetail}" Style="{StaticResource Prime.Body}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Fatores avaliados" Style="{StaticResource Prime.H3}" />
                    <ItemsControl ItemsSource="{Binding Findings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Prime.Subtle}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <DockPanel>
                                            <Border Style="{StaticResource Prime.LikelihoodBadge}" Tag="{Binding Likelihood}" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding LikelihoodLabel}" />
                                            </Border>
                                            <TextBlock Text="{Binding ShareText}" DockPanel.Dock="Right" Style="{StaticResource Prime.Caption}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource Prime.Text}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding Evidence}" ItemTemplate="{StaticResource BulletTemplate}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Métricas da sessão" Style="{StaticResource Prime.H3}" Margin="0,10,0,4" />
                    <DataGrid ItemsSource="{Binding Metrics}" Style="{StaticResource Prime.DataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Métrica" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Média" Binding="{Binding Average}" Width="*" />
                            <DataGridTextColumn Header="Percentil 95" Binding="{Binding P95}" Width="*" />
                            <DataGridTextColumn Header="Máximo" Binding="{Binding Max}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Sugestões (nada é alterado automaticamente)" Style="{StaticResource Prime.H3}" />
                            <ItemsControl ItemsSource="{Binding Suggestions}" ItemTemplate="{StaticResource BulletTemplate}" />
                            <TextBlock Text="Condições do teste" Style="{StaticResource Prime.H3}" Margin="0,10,0,4" />
                            <ItemsControl ItemsSource="{Binding Conditions}" ItemTemplate="{StaticResource BulletTemplate}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Limitações desta análise" Style="{StaticResource Prime.H3}" />
                            <ItemsControl ItemsSource="{Binding Limitations}" ItemTemplate="{StaticResource BulletTemplate}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Sessões salvas -->
            <Border Style="{StaticResource Prime.Card}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Comparar marcadas" Style="{StaticResource Prime.Button}" Command="{Binding CompareCommand}" />
                        <TextBlock Text="Sessões salvas" Style="{StaticResource Prime.H2}" />
                    </DockPanel>
                    <TextBlock Text="Nenhuma sessão gravada ainda." Style="{StaticResource Prime.Secondary}"
                               Visibility="{Binding Sessions.Count, Converter={StaticResource EmptyToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Sessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Prime.CardBorder}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                  ToolTip="Marcar para comparar" />
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="Abrir" Style="{StaticResource Prime.Button}" MinWidth="0" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.OpenSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="&#xE74D;" Style="{StaticResource Prime.IconButton}" ToolTip="Apagar sessão"
                                                    Command="{Binding DataContext.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Prime.Text}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Headline}" Style="{StaticResource Prime.Caption}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Margin="0,14,0,0" Visibility="{Binding Comparison, Converter={StaticResource NotNullToVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Fechar comparação" Style="{StaticResource Prime.Button}" Command="{Binding CloseComparisonCommand}" />
                            <TextBlock Text="Comparação" Style="{StaticResource Prime.H3}" />
                        </DockPanel>
                        <DataGrid x:Name="ComparisonGrid" ItemsSource="{Binding Comparison}" Style="{StaticResource Prime.DataGrid}"
                                  AutoGenerateColumns="True" AutoGeneratingColumn="OnComparisonColumn" Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
