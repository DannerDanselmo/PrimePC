<UserControl x:Class="PrimePC.App.Views.SensorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PrimePC.App.Controls">
    <Grid Margin="32,4,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Abas por componente -->
        <ListBox ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" ItemContainerStyle="{StaticResource Prime.TabPill}"
                 Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,6"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Componentes">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <!-- Filtros -->
        <Border Grid.Row="1" Style="{StaticResource Prime.Card}" Padding="16,12">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,14,8">
                        <TextBlock Text="Buscar" Style="{StaticResource Prime.Caption}" Margin="0,0,0,3" />
                        <TextBox Width="220" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Buscar sensores" ToolTip="Nome do sensor, componente ou tipo" />
                    </StackPanel>

                    <StackPanel Margin="0,0,14,8">
                        <TextBlock Text="Tipo" Style="{StaticResource Prime.Caption}" Margin="0,0,0,3" />
                        <ComboBox Width="190" ItemsSource="{Binding KindOptions}" SelectedItem="{Binding SelectedKind}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,8" VerticalAlignment="Bottom">
                        <CheckBox Content="Somente favoritos" IsChecked="{Binding OnlyFavorites}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,8" VerticalAlignment="Bottom">
                        <CheckBox Content="Mostrar indisponíveis" IsChecked="{Binding ShowUnavailable}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,8" VerticalAlignment="Bottom">
                        <CheckBox Content="Mostrar ocultos" IsChecked="{Binding ShowHidden}" />
                    </StackPanel>
                </WrapPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Redefinir mín./máx." Style="{StaticResource Prime.Button}" Margin="0,0,8,0"
                                Command="{Binding ResetStatisticsCommand}" ToolTip="Zera mínimos, médias e máximos (inicia uma nova sessão)" />
                        <Button Content="Exportar histórico (CSV)" Style="{StaticResource Prime.Button}"
                                Command="{Binding ExportHistoryCommand}" ToolTip="Exporta o histórico recente dos sensores visíveis" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Prime.Secondary}" VerticalAlignment="Center">
                        <Run Text="{Binding VisibleCount, Mode=OneWay}" /><Run Text=" sensores exibidos · " /><Run
                            Text="{Binding UnavailableCount, Mode=OneWay}" /><Run Text=" sem leitura disponível no momento (passe o mouse sobre o estado para ver o motivo)" />
                    </TextBlock>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Tabela (ListBox agrupada: cada linha usa as mesmas colunas proporcionais) -->
        <Border Grid.Row="2" Style="{StaticResource Prime.Card}" Padding="8,10,8,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="12,0,26,6" TextElement.FontWeight="SemiBold" TextElement.FontSize="12"
                      TextElement.Foreground="{DynamicResource Prime.TextSecondary}">
                    <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="2.2*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.8*" />
                                    <ColumnDefinition Width="34" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Sensor" />
                    <TextBlock Grid.Column="2" Text="Valor" />
                    <TextBlock Grid.Column="3" Text="Mínimo" />
                    <TextBlock Grid.Column="4" Text="Média" />
                    <TextBlock Grid.Column="5" Text="Máximo" />
                    <TextBlock Grid.Column="6" Text="Tipo" />
                    <TextBlock Grid.Column="7" Text="Estado" />
                    <TextBlock Grid.Column="8" Text="Origem" />
                </Grid>
                <ListBox Grid.Row="1" ItemsSource="{Binding View}" SelectedItem="{Binding SelectedRow}"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         AutomationProperties.Name="Tabela de sensores">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Prime.SubtleBg}" Padding="10,6" Margin="0,8,0,2" CornerRadius="4">
                                        <TextBlock Foreground="{DynamicResource Prime.Text}">
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run
                                                Text="{Binding ItemCount, Mode=OneWay, StringFormat=' · {0} sensores'}" Foreground="{DynamicResource Prime.TextSecondary}" />
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="4,3" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="34" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="2.2*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.8*" />
                                    <ColumnDefinition Width="34" />
                                </Grid.ColumnDefinitions>
                                <Button Content="{Binding FavoriteGlyph}" Style="{StaticResource Prime.IconButton}"
                                        Foreground="{DynamicResource Prime.Accent}" ToolTip="Favoritar / desfavoritar"
                                        Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource Prime.Text}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{Binding Name}" />
                                <TextBlock Grid.Column="2" Text="{Binding ValueText}" Tag="{Binding State}" Style="{StaticResource Prime.StateValue}"
                                           FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding StateReason}" />
                                <TextBlock Grid.Column="3" Text="{Binding MinText}" Style="{StaticResource Prime.Caption}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{Binding AverageText}" Style="{StaticResource Prime.Caption}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="{Binding MaxText}" Style="{StaticResource Prime.Caption}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="6" Text="{Binding KindText}" Style="{StaticResource Prime.Caption}" VerticalAlignment="Center" />
                                <Border Grid.Column="7" Style="{StaticResource Prime.StateBadge}" Tag="{Binding State}" ToolTip="{Binding StateReason}">
                                    <TextBlock Text="{Binding StateText}" />
                                </Border>
                                <TextBlock Grid.Column="8" Text="{Binding Source}" Style="{StaticResource Prime.Caption}" ToolTip="{Binding Source}"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Button Grid.Column="9" Content="{Binding HiddenGlyph}" Style="{StaticResource Prime.IconButton}" ToolTip="Ocultar / mostrar"
                                        Command="{Binding DataContext.ToggleHiddenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Detalhes do sensor selecionado -->
        <Border Grid.Row="3" Style="{StaticResource Prime.Card}" Margin="0"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource Prime.H3}" Margin="0,0,0,6">
                        <Run Text="Histórico recente — " /><Run Text="{Binding SelectedRow.Name, Mode=OneWay}" />
                    </TextBlock>
                    <c:LineChart Height="150" Series="{Binding SelectedSeries}" Stroke="{DynamicResource Prime.Chart1}"
                                 Fill="{DynamicResource Prime.Chart1Fill}" GridBrush="{DynamicResource Prime.ChartGrid}"
                                 TextBrush="{DynamicResource Prime.TextSecondary}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding SelectedRow.Group}" Style="{StaticResource Prime.Caption}" />
                    <TextBlock Text="{Binding SelectedRow.Source}" Style="{StaticResource Prime.Caption}" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource Prime.Body}">
                        <Run Text="Atual: " /><Run Text="{Binding SelectedRow.ValueText, Mode=OneWay}" FontWeight="SemiBold" /><Run
                            Text="   Mín.: " /><Run Text="{Binding SelectedRow.MinText, Mode=OneWay}" /><Run Text="   Máx.: " /><Run
                            Text="{Binding SelectedRow.MaxText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding SelectedRow.StateReason}" Style="{StaticResource Prime.Secondary}" Margin="0,4,0,10" />
                    <TextBlock Text="Criar alerta para este sensor" Style="{StaticResource Prime.H3}" />
                    <WrapPanel>
                        <ComboBox Width="110" ItemsSource="{Binding ComparisonOptions}" SelectedIndex="{Binding AlertComparisonIndex}"
                                  Margin="0,0,6,6" AutomationProperties.Name="Condição do alerta" />
                        <TextBox Width="80" Text="{Binding AlertThreshold, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,6"
                                 AutomationProperties.Name="Limite do alerta" />
                        <TextBlock Text="por" Style="{StaticResource Prime.Secondary}" VerticalAlignment="Center" Margin="0,0,6,6" />
                        <TextBox Width="50" Text="{Binding AlertDurationSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,6"
                                 AutomationProperties.Name="Duração mínima em segundos" />
                        <TextBlock Text="s" Style="{StaticResource Prime.Secondary}" VerticalAlignment="Center" Margin="0,0,10,6" />
                        <Button Content="Criar alerta" Style="{StaticResource Prime.PrimaryButton}" Command="{Binding CreateAlertCommand}"
                                MinWidth="0" Margin="0,0,0,6" />
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
