<UserControl x:Class="PrimePC.App.Views.OverlayPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PrimePC.App.Controls"
             xmlns:s="clr-namespace:PrimePC.Sensors;assembly=PrimePC.Sensors"
             SnapsToDevicePixels="True" UseLayoutRounding="True">
    <!-- Cores fixas: a sobreposição fica sobre o jogo, independente do tema claro/escuro do PrimePC. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis" />
        <SolidColorBrush x:Key="Ov.Value" Color="#F5F7FF" />
        <SolidColorBrush x:Key="Ov.Unit" Color="#A3ACC2" />
        <SolidColorBrush x:Key="Ov.Red" Color="#FF3550" />
        <SolidColorBrush x:Key="Ov.Orange" Color="#FF8A2E" />
        <Style x:Key="Ov.Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Width" Value="42" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Ov.Num" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ov.Value}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
        <Style x:Key="Ov.Temp" TargetType="TextBlock" BasedOn="{StaticResource Ov.Num}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static s:SensorState.Warning}">
                    <Setter Property="Foreground" Value="#FFB020" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static s:SensorState.Critical}">
                    <Setter Property="Foreground" Value="#FF3D8B" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border CornerRadius="3" Padding="12,7,2,7" BorderThickness="1">
        <Border.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
        </Border.LayoutTransform>
        <Border.Background>
            <SolidColorBrush Color="#08080A" Opacity="{Binding BackgroundOpacity}" />
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#E6FF2340" Offset="0" />
                <GradientStop Color="#80FF7A18" Offset="1" />
            </LinearGradientBrush>
        </Border.BorderBrush>

        <StackPanel TextElement.FontFamily="Bahnschrift">
            <StackPanel.Effect>
                <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.9" Color="Black" />
            </StackPanel.Effect>

            <TextBlock Text="{Binding RecordingText}" Foreground="#FFD233" FontSize="13" FontWeight="Bold" Margin="0,0,12,4"
                       Visibility="{Binding HasRecording, Converter={StaticResource Vis}}" />
            <TextBlock Text="{Binding ToastText}" Foreground="{StaticResource Ov.Red}" FontSize="13" FontWeight="Bold" Margin="0,0,12,4"
                       Visibility="{Binding HasToast, Converter={StaticResource Vis}}" />

            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowClock, Converter={StaticResource Vis}}">
                <TextBlock Text="HORA" Style="{StaticResource Ov.Label}" Foreground="{StaticResource Ov.Unit}" />
                <TextBlock Text="{Binding ClockText}" Style="{StaticResource Ov.Num}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowFpsRow, Converter={StaticResource Vis}}">
                <TextBlock Text="FPS" Style="{StaticResource Ov.Label}" Foreground="{StaticResource Ov.Red}" />
                <TextBlock Text="{Binding FpsText}" Style="{StaticResource Ov.Num}" FontSize="21" MinWidth="44"
                           Visibility="{Binding ShowFps, Converter={StaticResource Vis}}" />
                <TextBlock Text="{Binding FrameTimeText}" Style="{StaticResource Ov.Num}" MinWidth="64"
                           Visibility="{Binding ShowFrameTime, Converter={StaticResource Vis}}" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding ShowLow1, Converter={StaticResource Vis}}">
                    <TextBlock Text="1%" Foreground="{StaticResource Ov.Unit}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding Low1Text}" Style="{StaticResource Ov.Num}" MinWidth="30" />
                </StackPanel>
            </StackPanel>

            <c:FrameTimeGraph Values="{Binding FrameTimes}" Height="28" Margin="0,4,12,4"
                              Visibility="{Binding ShowGraph, Converter={StaticResource Vis}}" />

            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowCpuRow, Converter={StaticResource Vis}}">
                <TextBlock Text="CPU" Style="{StaticResource Ov.Label}" Foreground="{StaticResource Ov.Orange}" />
                <TextBlock Text="{Binding CpuLoadText}" Style="{StaticResource Ov.Num}" MinWidth="52"
                           Visibility="{Binding ShowCpuLoad, Converter={StaticResource Vis}}" />
                <TextBlock Text="{Binding CpuTempText}" Tag="{Binding CpuTempState}" Style="{StaticResource Ov.Temp}" MinWidth="54"
                           Visibility="{Binding ShowCpuTemp, Converter={StaticResource Vis}}" />
                <TextBlock Text="{Binding CpuPowerText}" Style="{StaticResource Ov.Num}" MinWidth="50"
                           Visibility="{Binding ShowCpuPower, Converter={StaticResource Vis}}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowGpuRow, Converter={StaticResource Vis}}">
                <TextBlock Text="GPU" Style="{StaticResource Ov.Label}" Foreground="{StaticResource Ov.Orange}" />
                <TextBlock Text="{Binding GpuLoadText}" Style="{StaticResource Ov.Num}" MinWidth="52"
                           Visibility="{Binding ShowGpuLoad, Converter={StaticResource Vis}}" />
                <TextBlock Text="{Binding GpuTempText}" Tag="{Binding GpuTempState}" Style="{StaticResource Ov.Temp}" MinWidth="54"
                           Visibility="{Binding ShowGpuTemp, Converter={StaticResource Vis}}" />
                <TextBlock Text="{Binding GpuClockText}" Style="{StaticResource Ov.Num}" MinWidth="84"
                           Visibility="{Binding ShowGpuClock, Converter={StaticResource Vis}}" />
                <TextBlock Text="{Binding GpuPowerText}" Style="{StaticResource Ov.Num}" MinWidth="50"
                           Visibility="{Binding ShowGpuPower, Converter={StaticResource Vis}}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowVram, Converter={StaticResource Vis}}">
                <TextBlock Text="VRAM" Style="{StaticResource Ov.Label}" Foreground="{StaticResource Ov.Orange}" />
                <TextBlock Text="{Binding VramText}" Style="{StaticResource Ov.Num}" MinWidth="52" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowRam, Converter={StaticResource Vis}}">
                <TextBlock Text="RAM" Style="{StaticResource Ov.Label}" Foreground="{StaticResource Ov.Orange}" />
                <TextBlock Text="{Binding RamText}" Style="{StaticResource Ov.Num}" MinWidth="52" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowPing, Converter={StaticResource Vis}}">
                <TextBlock Text="{Binding PingLabel}" Style="{StaticResource Ov.Label}" Foreground="{StaticResource Ov.Red}" />
                <TextBlock Text="{Binding PingText}" Style="{StaticResource Ov.Num}" MinWidth="52" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
