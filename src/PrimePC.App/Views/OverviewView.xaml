<UserControl x:Class="PrimePC.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PrimePC.App.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="InfoRowTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Style="{StaticResource Prime.Secondary}" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Prime.Body}" />
            </Grid>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <WrapPanel />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,4,32,28">

            <!-- Favoritos -->
            <Border Style="{StaticResource Prime.Card}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Escolher sensores" Style="{StaticResource Prime.Button}"
                                Command="{Binding OpenSensorsCommand}" VerticalAlignment="Top" />
                        <TextBlock Text="Favoritos" Style="{StaticResource Prime.H2}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Prime.Secondary}"
                               Visibility="{Binding HasFavorites, Converter={StaticResource InverseBoolToVisibility}}"
                               Text="Nenhum favorito ainda. Na aba Sensores, clique na estrela ao lado de um sensor para acompanhá-lo aqui." />
                    <ItemsControl ItemsSource="{Binding Favorites}" ItemsPanel="{StaticResource WrapPanelTemplate}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Prime.Subtle}" Width="250" Margin="0,0,12,12" ToolTip="{Binding Tooltip}">
                                    <StackPanel>
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Content="&#xE70E;" Style="{StaticResource Prime.IconButton}" ToolTip="Mover para cima"
                                                        Command="{Binding DataContext.MoveFavoriteUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="&#xE70D;" Style="{StaticResource Prime.IconButton}" ToolTip="Mover para baixo"
                                                        Command="{Binding DataContext.MoveFavoriteDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="&#xE711;" Style="{StaticResource Prime.IconButton}" ToolTip="Remover dos favoritos"
                                                        Command="{Binding DataContext.RemoveFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Prime.Text}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Hardware}" Style="{StaticResource Prime.Caption}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Value}" Tag="{Binding State}" Style="{StaticResource Prime.StateValue}"
                                                   FontSize="22" FontWeight="SemiBold" Margin="0,6,0,4" />
                                        <c:LineChart Height="44" ShowAxis="False" Series="{Binding Series}" WindowSeconds="180"
                                                     Stroke="{DynamicResource Prime.Chart1}" Fill="{DynamicResource Prime.Chart1Fill}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- CPU e GPU -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Prime.Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="&#xE950;" Style="{StaticResource Prime.Icon}" FontSize="22" Margin="0,0,12,0"
                                       Foreground="{DynamicResource Prime.Accent}" />
                            <StackPanel>
                                <TextBlock Text="{Binding CpuName}" Style="{StaticResource Prime.H2}" Margin="0" />
                                <TextBlock Text="{Binding CpuDetail}" Style="{StaticResource Prime.Caption}" />
                            </StackPanel>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding CpuMetrics}" ItemsPanel="{StaticResource WrapPanelTemplate}" />
                        <TextBlock Text="Uso total da CPU (últimos 2 minutos)" Style="{StaticResource Prime.Caption}" Margin="0,4,0,4" />
                        <c:LineChart Height="110" Series="{Binding CpuSeries}" Minimum="0" Maximum="100" WindowSeconds="120"
                                     Stroke="{DynamicResource Prime.Chart1}" Fill="{DynamicResource Prime.Chart1Fill}"
                                     GridBrush="{DynamicResource Prime.ChartGrid}" TextBrush="{DynamicResource Prime.TextSecondary}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Prime.Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="&#xE7F4;" Style="{StaticResource Prime.Icon}" FontSize="22" Margin="0,0,12,0"
                                       Foreground="{DynamicResource Prime.Accent}" />
                            <StackPanel>
                                <TextBlock Text="{Binding GpuName}" Style="{StaticResource Prime.H2}" Margin="0" />
                                <TextBlock Text="{Binding GpuDetail}" Style="{StaticResource Prime.Caption}" />
                            </StackPanel>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding GpuMetrics}" ItemsPanel="{StaticResource WrapPanelTemplate}" />
                        <ProgressBar Value="{Binding VramPercent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,0,0,8"
                                     ToolTip="Ocupação da memória de vídeo" />
                        <TextBlock Text="Uso da GPU (últimos 2 minutos)" Style="{StaticResource Prime.Caption}" Margin="0,4,0,4" />
                        <c:LineChart Height="110" Series="{Binding GpuSeries}" Minimum="0" Maximum="100" WindowSeconds="120"
                                     Stroke="{DynamicResource Prime.Chart2}" Fill="{DynamicResource Prime.Chart2Fill}"
                                     GridBrush="{DynamicResource Prime.ChartGrid}" TextBrush="{DynamicResource Prime.TextSecondary}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- RAM e sistema -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Prime.Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="&#xE964;" Style="{StaticResource Prime.Icon}" FontSize="22" Margin="0,0,12,0"
                                       Foreground="{DynamicResource Prime.Accent}" />
                            <StackPanel>
                                <TextBlock Text="{Binding RamTitle}" Style="{StaticResource Prime.H2}" Margin="0" />
                                <TextBlock Text="{Binding RamDetail}" Style="{StaticResource Prime.Caption}" />
                            </StackPanel>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding RamMetrics}" ItemsPanel="{StaticResource WrapPanelTemplate}" />
                        <ProgressBar Value="{Binding RamPercent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,0,0,8" />
                        <c:LineChart Height="80" Series="{Binding RamSeries}" Minimum="0" Maximum="100" WindowSeconds="120"
                                     Stroke="{DynamicResource Prime.Chart1}" Fill="{DynamicResource Prime.Chart1Fill}"
                                     GridBrush="{DynamicResource Prime.ChartGrid}" TextBrush="{DynamicResource Prime.TextSecondary}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Prime.Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="&#xE770;" Style="{StaticResource Prime.Icon}" FontSize="22" Margin="0,0,12,0"
                                       Foreground="{DynamicResource Prime.Accent}" />
                            <StackPanel>
                                <TextBlock Text="Sistema" Style="{StaticResource Prime.H2}" Margin="0" />
                                <TextBlock Text="{Binding OsText}" Style="{StaticResource Prime.Caption}" />
                            </StackPanel>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding SystemMetrics}" ItemsPanel="{StaticResource WrapPanelTemplate}" />
                        <ItemsControl ItemsSource="{Binding SystemInfo}" ItemTemplate="{StaticResource InfoRowTemplate}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Placa-mãe e refrigeração -->
            <Border Style="{StaticResource Prime.Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Reiniciar como administrador" Style="{StaticResource Prime.Button}"
                                Command="{Binding RestartAsAdministratorCommand}" VerticalAlignment="Top"
                                Visibility="{Binding CanElevate, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="&#xE9CA;" Style="{StaticResource Prime.Icon}" FontSize="22" Margin="0,0,12,0"
                                   Foreground="{DynamicResource Prime.Accent}" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Text="{Binding BoardTitle}" Style="{StaticResource Prime.H2}" Margin="0" />
                            <TextBlock Text="{Binding BoardHint}" Style="{StaticResource Prime.Secondary}" />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Visibility="{Binding HasBoardSensors, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Temperaturas" Style="{StaticResource Prime.H3}"
                                   Visibility="{Binding BoardTemperatures.Count, Converter={StaticResource NotEmptyToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding BoardTemperatures}" ItemsPanel="{StaticResource WrapPanelTemplate}" />
                        <TextBlock Text="Ventoinhas e bomba" Style="{StaticResource Prime.H3}"
                                   Visibility="{Binding BoardFans.Count, Converter={StaticResource NotEmptyToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding BoardFans}" ItemsPanel="{StaticResource WrapPanelTemplate}" />
                        <TextBlock Text="Tensões" Style="{StaticResource Prime.H3}"
                                   Visibility="{Binding BoardRails.Count, Converter={StaticResource NotEmptyToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding BoardRails}" ItemsPanel="{StaticResource WrapPanelTemplate}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Armazenamento -->
            <Border Style="{StaticResource Prime.Card}">
                <StackPanel>
                    <TextBlock Text="Armazenamento" Style="{StaticResource Prime.H2}" />
                    <TextBlock Text="Identificando discos…" Style="{StaticResource Prime.Secondary}"
                               Visibility="{Binding InventoryLoaded, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Disks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Prime.Subtle}" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Prime.Text}" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Prime.Caption}" />
                                            <TextBlock Text="{Binding HealthText}" Style="{StaticResource Prime.Caption}" />
                                            <TextBlock Text="{Binding Volumes}" Style="{StaticResource Prime.Secondary}" Margin="0,4,0,0" />
                                            <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,8,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                                            <ContentControl Content="{Binding Temperature}" Focusable="False" />
                                            <ContentControl Content="{Binding Activity}" Focusable="False" />
                                            <ContentControl Content="{Binding UsedSpace}" Focusable="False" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Detalhes do hardware -->
            <Border Style="{StaticResource Prime.Card}">
                <StackPanel>
                    <TextBlock Text="Detalhes do hardware" Style="{StaticResource Prime.H2}" />
                    <Expander Header="Processador" IsExpanded="False" Margin="0,0,0,6">
                        <ItemsControl ItemsSource="{Binding CpuInfo}" ItemTemplate="{StaticResource InfoRowTemplate}" Margin="8,6,0,6" />
                    </Expander>
                    <Expander Header="Placa-mãe e firmware" Margin="0,0,0,6">
                        <ItemsControl ItemsSource="{Binding BoardInfo}" ItemTemplate="{StaticResource InfoRowTemplate}" Margin="8,6,0,6" />
                    </Expander>
                    <Expander Header="Módulos de memória" Margin="0,0,0,6">
                        <StackPanel Margin="8,6,0,6">
                            <DataGrid ItemsSource="{Binding MemoryModules}" Style="{StaticResource Prime.DataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Slot" Binding="{Binding Slot}" Width="Auto" />
                                    <DataGridTextColumn Header="Banco" Binding="{Binding Bank}" Width="Auto" />
                                    <DataGridTextColumn Header="Capacidade" Binding="{Binding Capacity}" Width="Auto" />
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="Auto" />
                                    <DataGridTextColumn Header="Velocidade configurada" Binding="{Binding Configured}" Width="Auto" />
                                    <DataGridTextColumn Header="Velocidade (SMBIOS)" Binding="{Binding Rated}" Width="Auto" />
                                    <DataGridTextColumn Header="Fabricante" Binding="{Binding Manufacturer}" Width="Auto" />
                                    <DataGridTextColumn Header="Modelo" Binding="{Binding Model}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="{Binding MemoryNote}" Style="{StaticResource Prime.Secondary}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Expander>
                    <Expander Header="Placas de vídeo" Margin="0,0,0,6">
                        <DataGrid ItemsSource="{Binding GpuList}" Style="{StaticResource Prime.DataGrid}" Margin="8,6,0,6">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Modelo" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Fabricante" Binding="{Binding Vendor}" Width="Auto" />
                                <DataGridTextColumn Header="Memória dedicada" Binding="{Binding Memory}" Width="Auto" />
                                <DataGridTextColumn Header="Driver" Binding="{Binding Driver}" Width="Auto" />
                                <DataGridTextColumn Header="Data do driver" Binding="{Binding DriverDate}" Width="Auto" />
                                <DataGridTextColumn Header="Modo de vídeo" Binding="{Binding Mode}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Expander>
                    <TextBlock Text="{Binding InventoryNotes}" Style="{StaticResource Prime.Secondary}" Margin="0,6,0,0"
                               Visibility="{Binding InventoryNotes, Converter={StaticResource NotNullToVisibility}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
